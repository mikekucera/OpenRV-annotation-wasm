{
  "name": "@autodesk/openrv-annotation-wasm",
  "version": "0.2.4",
  "main": "./dist/annotation_platform.js",
  "exports": {
    ".": "./dist/annotation_platform.js",
    "./shaders/*": "./deps/OpenRV-annotation/assets/shaders/*"
  },
